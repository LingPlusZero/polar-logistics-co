APP_NAME="Polar Logistics API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8443

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# 容器內直接輸出到 stderr（docker compose logs 可看），避免 log 檔權限問題
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=polar_logistics
DB_USERNAME=polar
DB_PASSWORD=polar

# 純 API 不使用 session，快取與佇列也先不依賴資料表
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
